{
  "name": "@straitlink/mcp",
  "version": "0.5.0",
  "mcpName": "in.straitlink/mcp",
  "description": "Strait MCP server: create, search, pause and resume deep links, QR codes, analytics comparisons and top links, recent taps and events, custom domains, webhooks, App Links / Universal Links checks and the docs, from AI tools. Stdio command and a library for remote hosts.",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "strait",
    "deep-linking",
    "app-links",
    "universal-links",
    "analytics"
  ],
  "homepage": "https://straitlink.in/docs/",
  "bugs": {
    "url": "https://github.com/strait-link/strait-mcp/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/strait-link/strait-mcp.git"
  },
  "license": "MIT",
  "author": "The Strait team <support@straitlink.in>",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "strait-mcp": "dist/stdio.js"
  },
  "files": [
    "dist/"
  ],
  "scripts": {
    "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json && tsc -p tsconfig.worker.json",
    "test": "vitest run",
    "docs-index": "node scripts/build-docs-index.mjs",
    "start": "node dist/stdio.js",
    "inspect": "npx -y @modelcontextprotocol/inspector@0.17.5 --cli node dist/stdio.js --method tools/list",
    "dev:remote": "npx -y wrangler@4 dev",
    "deploy:check": "npx -y wrangler@4 deploy --dry-run --env production --outdir .wrangler/dry-run",
    "deploy:preflight": "tsx scripts/deploy-preflight.ts",
    "skill:sync": "node scripts/sync-skill.mjs",
    "prepack": "npm run build"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@cloudflare/workers-oauth-provider": "^1.2.1",
    "@cloudflare/workers-types": "^5.20261004.1",
    "@types/node": "^22.20.5",
    "tsx": "^4.23.15",
    "typescript": "5.9",
    "vitest": "^4.1.12"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
