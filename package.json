{
  "name": "@strait/mcp",
  "version": "0.1.0",
  "private": true,
  "description": "Strait MCP server: create and inspect deep links, read analytics, check App Links / Universal Links files and search the docs from AI tools.",
  "type": "module",
  "bin": {
    "strait-mcp": "dist/stdio.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json && tsc -p tsconfig.worker.json",
    "test": "vitest run",
    "docs-index": "node scripts/build-docs-index.mjs",
    "start": "node dist/stdio.js",
    "inspect": "npx -y @modelcontextprotocol/inspector@0.17.5 --cli node dist/stdio.js --method tools/list"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "UNLICENSED",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@cloudflare/workers-oauth-provider": "^1.2.1",
    "@cloudflare/workers-types": "^5.20261004.1",
    "@types/node": "^22.20.5",
    "tsx": "^4.23.15",
    "typescript": "5.9",
    "vitest": "^4.1.8"
  }
}
